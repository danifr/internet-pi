# {{ ansible_managed }}
---
services:
  homebridge:
    image: homebridge/homebridge:{{ docker_image_versions.homebridge }}
    container_name: homebridge
    restart: always
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_ADMIN
{% if homebridge_devices | default([]) %}
    devices:
{% for device in homebridge_devices | default([]) %}
      - "{{ device }}"
{% endfor %}
{% endif %}
    volumes:
      - ./homebridge:/homebridge
    environment:
      - PGID=1000
      - PUID=1000
      - HOMEBRIDGE_CONFIG_UI=1
      - HOMEBRIDGE_CONFIG_UI_PORT={{ homebridge_port }}

{% if domain_name_enable and domain_name and domain_homebridge %}
  homebridge-proxy:
    image: nginx:alpine
    container_name: homebridge-proxy
    restart: always
    networks:
      - front-tier
    environment:
      - VIRTUAL_HOST={{ domain_homebridge }}.{{ domain_name }}
      - VIRTUAL_PORT=80
    volumes:
      - ./nginx-proxy.conf:/etc/nginx/conf.d/default.conf:ro

networks:
  front-tier:
    name: internet-monitoring-front-tier
    external: true
{% endif %}
